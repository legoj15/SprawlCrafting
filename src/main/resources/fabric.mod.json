{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://github.com/legoj15/SprawlCrafting",
        "sources": "https://github.com/legoj15/SprawlCrafting",
        "issues": "https://github.com/legoj15/SprawlCrafting/issues"
    },
    "license": "${license}",
    "icon": "assets/sprawlcrafting/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.legoj15.sprawlcrafting.platform.fabric.FabricMod"
        ],
        "client": [
            "com.legoj15.sprawlcrafting.platform.fabric.FabricClient"
        ],
        "jei_mod_plugin": [
            "com.legoj15.sprawlcrafting.compat.jei.SprawlCraftingJeiPlugin"<% if (has_ae2_jei) { %>,
            "com.legoj15.sprawlcrafting.compat.ae2.jei.StationJeiPlugin"<% } %>
        ],
        "rei_client": [
            "com.legoj15.sprawlcrafting.platform.fabric.FabricReiPlugin"
        ],
        "modmenu": [
            "com.legoj15.sprawlcrafting.platform.fabric.SprawlModMenuIntegration"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json"<% if (has_ae2_jei) { %>,
        "sprawlcrafting.ae2jei.mixins.json"<% } %>
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_min}",
        "fabric-api": "*",
        "minecraft": "${minecraft_version}",
        "java": ">=${java_version}"
    },
    "suggests": {
        "jei": "*",
        "roughlyenoughitems": "*",
        "modmenu": "*"
    }
}
  